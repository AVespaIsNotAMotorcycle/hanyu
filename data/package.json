{
  "name": "@hanyu/data",
  "version": "0.1.0",
  "private": true,
  "description": "Pipeline that builds the seed dataset in data/seed from pinned sources",
  "type": "module",
  "scripts": {
    "fetch": "tsx src/fetch.ts",
    "build:seed": "tsx src/build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "passages:generate": "tsx --env-file-if-exists=../.env src/passages/cli.ts generate",
    "passages:check": "tsx --env-file-if-exists=../.env src/passages/cli.ts check",
    "passages:translate": "tsx --env-file-if-exists=../.env src/passages/cli.ts translate",
    "passages:review": "tsx src/passages/cli.ts review",
    "passages:coverage": "tsx src/passages/cli.ts coverage",
    "grader:learner-set": "tsx --env-file-if-exists=../.env src/grader/cli.ts learner-set",
    "grader:eval": "tsx --env-file-if-exists=../.env src/grader/cli.ts eval",
    "grader:consistency": "tsx --env-file-if-exists=../.env src/grader/cli.ts consistency",
    "listening:generate": "tsx --env-file-if-exists=../.env src/listening/cli.ts generate",
    "listening:check": "tsx --env-file-if-exists=../.env src/listening/cli.ts check",
    "listening:review": "tsx src/listening/cli.ts review",
    "listening:coverage": "tsx src/listening/cli.ts coverage",
    "audio:generate": "tsx --env-file-if-exists=../.env src/audio/cli.ts generate",
    "audio:sample": "tsx --env-file-if-exists=../.env src/audio/cli.ts sample",
    "audio:status": "tsx src/audio/cli.ts status"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@hanyu/shared": "^0.1.0",
    "@msgpack/msgpack": "^3.1.3",
    "@node-rs/jieba": "^2.0.4"
  }
}
